# Database
DB_URL=jdbc:mysql://production-db-host:3306/rms?useSSL=true&serverTimezone=UTC
DB_USERNAME=prod_user
DB_PASSWORD=secure_password_here

# JWT
JWT_SECRET=your-very-long-secret-key-at-least-64-characters-for-production

# Upload Directory
UPLOAD_DIR=/var/www/rms/uploads

# CORS
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

export AT_USERNAME=your_username
export AT_API_KEY=your_api_key
export AT_SENDER_ID=your_sender_id